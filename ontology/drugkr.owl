<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/drugkr.owl"
         xmlns="http://example.org/drugkr.owl#">

<owl:Ontology rdf:about="http://example.org/drugkr.owl"/>

<owl:ObjectProperty rdf:about="#takesMedication">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Drug"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCondition">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#MedicalCondition"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metabolizedBy">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Enzyme"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inhibits">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Enzyme"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMechanism">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#InteractionMechanism"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSeverity">
  <rdfs:domain rdf:resource="#InteractionMechanism"/>
  <rdfs:range rdf:resource="#SeverityLevel"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#standardDoseMg">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#halfLifeHours">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ageYears">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isPregnant">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#creatinineClearance">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Drug">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Patient">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Enzyme">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MedicalCondition">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MAOI">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#SSRI">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Triptan">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Opioid">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Benzodiazepine">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Anticoagulant">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Antiplatelet">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#NSAID">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#CYP3A4Inhibitor">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#CYP3A4Substrate">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#QTProlongingAgent">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Sympathomimetic">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#InteractionMechanism">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SeverityLevel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SerotoninSyndromeRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#MAOI"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#SSRI"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#HypertensiveCrisisRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#MAOI"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Sympathomimetic"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#BleedingRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Anticoagulant"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#NSAID"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#takesMedication"/>
              <owl:someValuesFrom rdf:resource="#NSAID"/>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#takesMedication"/>
              <owl:someValuesFrom rdf:resource="#Antiplatelet"/>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Anticoagulant"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#QTProlongationRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:onClass rdf:resource="#QTProlongingAgent"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#CNSDepressionRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Opioid"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Benzodiazepine"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>


</rdf:RDF>
