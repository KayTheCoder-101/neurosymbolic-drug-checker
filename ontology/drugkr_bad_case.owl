<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/drugkr.owl"
         xmlns="http://example.org/drugkr.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://example.org/drugkr.owl"/>

<owl:ObjectProperty rdf:about="#takesMedication">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Drug"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCondition">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#MedicalCondition"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#metabolizedBy">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Enzyme"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inhibits">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Enzyme"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMechanism">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#InteractionMechanism"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSeverity">
  <rdfs:domain rdf:resource="#InteractionMechanism"/>
  <rdfs:range rdf:resource="#SeverityLevel"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#standardDoseMg">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#halfLifeHours">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ageYears">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isPregnant">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#creatinineClearance">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSeverityLabel">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Drug">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Patient">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Enzyme">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MedicalCondition">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MAOI">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#SSRI">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Triptan">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Opioid">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Benzodiazepine">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Anticoagulant">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Antiplatelet">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#NSAID">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#CYP3A4Inhibitor">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#CYP3A4Substrate">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#QTProlongingAgent">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Sympathomimetic">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#InteractionMechanism">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SeverityLevel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SerotoninSyndromeRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#MAOI"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#SSRI"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#HypertensiveCrisisRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#MAOI"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Sympathomimetic"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#BleedingRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#takesMedication"/>
              <owl:someValuesFrom rdf:resource="#NSAID"/>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#takesMedication"/>
              <owl:someValuesFrom rdf:resource="#Antiplatelet"/>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Anticoagulant"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#QTProlongationRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:onClass rdf:resource="#QTProlongingAgent"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#CNSDepressionRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Opioid"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#Benzodiazepine"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#CYP3A4ToxicityRiskPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
</owl:Class>

<owl:Class rdf:about="#PregnantPatient">
  <rdfs:subClassOf rdf:resource="#Patient"/>
</owl:Class>

<owl:Class rdf:about="#AbsoluteContraindicationInPregnancy">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#ForbiddenPregnancyRegimen">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#PregnantPatient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#takesMedication"/>
          <owl:someValuesFrom rdf:resource="#AbsoluteContraindicationInPregnancy"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#CYP3A4">
  <rdf:type rdf:resource="#Enzyme"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Phenelzine">
  <rdf:type rdf:resource="#MAOI"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tranylcypromine">
  <rdf:type rdf:resource="#MAOI"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sertraline">
  <rdf:type rdf:resource="#SSRI"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Fluoxetine">
  <rdf:type rdf:resource="#SSRI"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sumatriptan">
  <rdf:type rdf:resource="#Triptan"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Tramadol">
  <rdf:type rdf:resource="#Opioid"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Morphine">
  <rdf:type rdf:resource="#Opioid"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Diazepam">
  <rdf:type rdf:resource="#Benzodiazepine"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Clopidogrel">
  <rdf:type rdf:resource="#Antiplatelet"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ibuprofen">
  <rdf:type rdf:resource="#NSAID"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ketoconazole">
  <rdf:type rdf:resource="#CYP3A4Inhibitor"/>
  <inhibits rdf:resource="#CYP3A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Clarithromycin">
  <rdf:type rdf:resource="#CYP3A4Inhibitor"/>
  <inhibits rdf:resource="#CYP3A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Simvastatin">
  <rdf:type rdf:resource="#CYP3A4Substrate"/>
  <metabolizedBy rdf:resource="#CYP3A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Haloperidol">
  <rdf:type rdf:resource="#QTProlongingAgent"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Pseudoephedrine">
  <rdf:type rdf:resource="#Sympathomimetic"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Citalopram">
  <rdf:type rdf:resource="#SSRI"/>
  <rdf:type rdf:resource="#QTProlongingAgent"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Alprazolam">
  <rdf:type rdf:resource="#Benzodiazepine"/>
  <rdf:type rdf:resource="#CYP3A4Substrate"/>
  <metabolizedBy rdf:resource="#CYP3A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aspirin">
  <rdf:type rdf:resource="#NSAID"/>
  <rdf:type rdf:resource="#Antiplatelet"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Amiodarone">
  <rdf:type rdf:resource="#QTProlongingAgent"/>
  <rdf:type rdf:resource="#CYP3A4Inhibitor"/>
  <inhibits rdf:resource="#CYP3A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Warfarin">
  <rdf:type rdf:resource="#Anticoagulant"/>
  <rdf:type rdf:resource="#AbsoluteContraindicationInPregnancy"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#P1_SerotoninRisk">
  <rdf:type rdf:resource="#Patient"/>
  <takesMedication rdf:resource="#Sertraline"/>
  <takesMedication rdf:resource="#Phenelzine"/>
  <rdf:type rdf:resource="#SerotoninSyndromeRiskPatient"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#P2_CYP3A4Risk">
  <rdf:type rdf:resource="#Patient"/>
  <takesMedication rdf:resource="#Ketoconazole"/>
  <takesMedication rdf:resource="#Simvastatin"/>
  <rdf:type rdf:resource="#CYP3A4ToxicityRiskPatient"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#P3_BleedingRisk">
  <rdf:type rdf:resource="#Patient"/>
  <takesMedication rdf:resource="#Aspirin"/>
  <takesMedication rdf:resource="#Warfarin"/>
  <rdf:type rdf:resource="#BleedingRiskPatient"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#P5_Safe">
  <rdf:type rdf:resource="#Patient"/>
  <takesMedication rdf:resource="#Diazepam"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#P4_PregnancyContradiction">
  <rdf:type rdf:resource="#PregnantPatient"/>
  <takesMedication rdf:resource="#Warfarin"/>
  <isPregnant rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isPregnant>
</owl:NamedIndividual>

<swrl:Variable rdf:about="urn:swrl#p"/>

<swrl:Variable rdf:about="urn:swrl#d1"/>

<swrl:Variable rdf:about="urn:swrl#e"/>

<swrl:Variable rdf:about="urn:swrl#d2"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#takesMedication"/>
              <swrl:argument1 rdf:resource="urn:swrl#p"/>
              <swrl:argument2 rdf:resource="urn:swrl#d1"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="#CYP3A4Inhibitor"/>
                  <swrl:argument1 rdf:resource="urn:swrl#d1"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#inhibits"/>
                      <swrl:argument1 rdf:resource="urn:swrl#d1"/>
                      <swrl:argument2 rdf:resource="urn:swrl#e"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#takesMedication"/>
                          <swrl:argument1 rdf:resource="urn:swrl#p"/>
                          <swrl:argument2 rdf:resource="urn:swrl#d2"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:ClassAtom>
                              <swrl:classPredicate rdf:resource="#CYP3A4Substrate"/>
                              <swrl:argument1 rdf:resource="urn:swrl#d2"/>
                            </swrl:ClassAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:IndividualPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#metabolizedBy"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#d2"/>
                                  <swrl:argument2 rdf:resource="urn:swrl#e"/>
                                </swrl:IndividualPropertyAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#CYP3A4ToxicityRiskPatient"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#takesMedication"/>
              <swrl:argument1 rdf:resource="urn:swrl#p"/>
              <swrl:argument2 rdf:resource="urn:swrl#d1"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="#CYP3A4Inhibitor"/>
                  <swrl:argument1 rdf:resource="urn:swrl#d1"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#inhibits"/>
                      <swrl:argument1 rdf:resource="urn:swrl#d1"/>
                      <swrl:argument2 rdf:resource="urn:swrl#e"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#takesMedication"/>
                          <swrl:argument1 rdf:resource="urn:swrl#p"/>
                          <swrl:argument2 rdf:resource="urn:swrl#d2"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:ClassAtom>
                              <swrl:classPredicate rdf:resource="#CYP3A4Substrate"/>
                              <swrl:argument1 rdf:resource="urn:swrl#d2"/>
                            </swrl:ClassAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:IndividualPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#metabolizedBy"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#d2"/>
                                  <swrl:argument2 rdf:resource="urn:swrl#e"/>
                                </swrl:IndividualPropertyAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#CYP3A4ToxicityRiskPatient"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>


</rdf:RDF>
